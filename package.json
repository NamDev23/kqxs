{
  "name": "kqxs-analysis-pro",
  "version": "2.0.0",
  "description": "Evidence-gated XSMB statistical research dashboard",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-appledouble.js",
    "build": "next build",
    "clean:appledouble": "node scripts/clean-appledouble.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/product-smoke-test.js",
    "test:product": "node scripts/product-smoke-test.js",
    "start": "node .next/standalone/server.js",
    "analyze": "node scripts/product-smoke-test.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:export": "node scripts/export-database.js",
    "db:import": "node scripts/import-database.js",
    "crawl": "node scripts/sync-missing-results.js",
    "data:audit": "node scripts/audit-lottery-data.js",
    "data:rebuild": "node scripts/rebuild-lottery-data.js",
    "daily:update": "node scripts/daily-auto-update.js",
    "daily:sync": "node scripts/sync-missing-results.js",
    "model:compare": "node scripts/model-comparison.js",
    "model:stability": "node scripts/model-stability.js",
    "model:live": "node scripts/live-performance.js",
    "model:backfill": "node scripts/backfill-prediction-evaluations.js",
    "model:outcomes": "node scripts/prediction-outcomes.js",
    "model:review": "node scripts/weekly-model-review.js",
    "release:check": "npm run data:audit && npm test && npm run typecheck && npm run build && npm audit",
    "test:telegram": "node scripts/telegram-smoke-test.js",
    "cron": "node analyzer/cron-scheduler.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.0",
    "cheerio": "^1.2.0",
    "date-fns": "^3.6.0",
    "next": "^16.2.10",
    "node-cron": "^4.6.0",
    "puppeteer": "^25.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.12.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.19",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
